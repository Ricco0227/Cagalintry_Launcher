# Normalise to LF in the repository; Git checks out native line endings.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.ico binary
*.icns binary
*.jar binary
*.zip binary
*.mrpack binary

# Generated — keep these out of diffs and language statistics.
package-lock.json linguist-generated=true
Cargo.lock linguist-generated=true
apps/launcher/src-tauri/icons/** linguist-vendored=true
