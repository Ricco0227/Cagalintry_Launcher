{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cagalintry Launcher",
  "version": "0.1.0",
  "identifier": "nl.salaba.cagalintry",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cagalintry Launcher",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 660,
        "resizable": true,
        "decorations": false,
        "center": true,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://cdn.modrinth.com https://api.modrinth.com https://crafatar.com https://mc-heads.net",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © Ricco0227",
    "category": "Game",
    "shortDescription": "Minecraft launcher with modpack sync",
    "longDescription": "A Minecraft launcher for the Cagalintry server, with Modrinth content and modpack sync between players.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
